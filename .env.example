# Application
APP_NAME=Justice AI
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/justice_ai

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT
ALGORITHM=HS256

# Embedding
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# LLM Providers
# Select one provider: mock, nvidia_build, openai, google
# mock = offline development only (NEVER presented as real AI output)
# nvidia_build = NVIDIA Build API (OpenAI-compatible endpoint)
# google = Google Gemini (OpenAI-compatible endpoint)
MODEL_PROVIDER=mock

# --- NVIDIA Build API ---
# Get a key at build.nvidia.com (keys start with nvapi-)
# NVIDIA_API_KEY=paste-your-key-here-it-looks-like-nvapi-plus-32-chars
# Default model: meta/llama-3.3-70b-instruct
# NOTE: verify current model availability at https://build.nvidia.com/models —
# NVIDIA deprecates model ids regularly. Override with NVIDIA_MODEL_NAME.
# NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini (OpenAI compatibility endpoint) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default model: gemini-3.8-flash (override with GEMINI_MODEL_NAME)
# GEMINI_MODEL_NAME=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Generic overrides (apply to whichever single provider is selected)
# MODEL_BASE_URL=
# MODEL_API_KEY=
# MODEL_NAME=

# --- Automatic failover ---
# Comma-separated provider priority order (e.g. "nvidia_build,google").
# Each listed provider whose API key is configured becomes a chain candidate;
# the first healthy candidate wins. Failed providers enter cooldown.
# MODEL_PROVIDER_ORDER=nvidia_build,google
# Seconds a failed provider is skipped before retry
# MODEL_COOLDOWN_SECONDS=60
# Hard per-provider deadline for one generation attempt (incl. internal retries)
# MODEL_REQUEST_DEADLINE_SECONDS=60

# Per-request tuning
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=3
MODEL_RETRY_DELAY_SECONDS=1

# RAG
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File upload
MAX_UPLOAD_SIZE=10485760

# Tenant
DEFAULT_TENANT_ID=default
